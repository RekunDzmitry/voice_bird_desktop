# Voice Bird Desktop - Environment Configuration
# Copy this file to .env and fill in your configuration

# Voice Bird Server Configuration
# Server URL - WebSocket endpoint for Opus-encoded audio streaming
# The client will connect to: wss://your-server.com/api/audio/stream
VOICE_BIRD_SERVER_URL=https://voice-bird-app-ebrln.ondigitalocean.app

# Your unique API key for authentication with the Voice Bird server
# This identifies you as a specific user across all your devices
VOICE_BIRD_API_KEY=your-user-api-key-here
