# Voice Bird Desktop - Environment Configuration
# Copy this file to .env and fill in your API keys

# AssemblyAI API Key (for real-time speech-to-text transcription)
# Get your free API key at: https://www.assemblyai.com/
# Free tier includes $50 credit (333 hours of transcription)
ASSEMBLYAI_API_KEY=your-api-key-here

# Voice Bird Server Configuration (for streaming audio to your custom server)
# Server URL - WebSocket endpoint for audio streaming
VOICE_BIRD_SERVER_URL=https://voice-bird-app-ebrln.ondigitalocean.app

# Your unique API key for authentication with the Voice Bird server
# This identifies you as a specific user across all your devices
VOICE_BIRD_API_KEY=your-user-api-key-here
