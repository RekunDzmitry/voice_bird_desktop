#!/usr/bin/env node

const os = require("os");
const path = require("path");
const fs = require("fs");
const { spawnSync, execSync } = require("child_process");

const PLATFORM_PACKAGES = {
  "win32 x64": {
    pkg: "@voice-bird/cli-win32-x64",
    bin: "voice-bird-cli.exe",
  },
  "darwin x64": {
    pkg: "@voice-bird/cli-darwin-x64",
    bin: "voice-bird-cli",
  },
  "darwin arm64": {
    pkg: "@voice-bird/cli-darwin-arm64",
    bin: "VoiceBirdCLI.app/Contents/MacOS/voice-bird-cli",
    app: "VoiceBirdCLI.app",
  },
  "linux x64": {
    pkg: "@voice-bird/cli-linux-x64",
    bin: "voice-bird-cli",
  },
};

function getBinaryPath() {
  if (process.env.VOICE_BIRD_CLI_BINARY_PATH) {
    return process.env.VOICE_BIRD_CLI_BINARY_PATH;
  }

  const platformKey = `${process.platform} ${os.arch()}`;
  const entry = PLATFORM_PACKAGES[platformKey];

  if (!entry) {
    console.error(
      `Unsupported platform: ${process.platform} ${os.arch()}\n` +
        `Supported: win32-x64, darwin-x64, darwin-arm64, linux-x64`
    );
    process.exit(1);
  }

  // Try resolving from the platform-specific optional dependency
  try {
    return require.resolve(path.join(entry.pkg, entry.bin));
  } catch {
    // Fallback: check if postinstall downloaded it
    const downloadedPath = path.join(__dirname, "..", "bin", entry.bin);
    if (fs.existsSync(downloadedPath)) {
      return downloadedPath;
    }
  }

  console.error(
    `Could not find the voice-bird-cli binary for ${platformKey}.\n` +
      `The package "${entry.pkg}" should have been installed as an optionalDependency.\n` +
      `Try reinstalling: npm install -g voice-bird-cli`
  );
  process.exit(1);
}

function getAppBundlePath(binPath) {
  const platformKey = `${process.platform} ${os.arch()}`;
  const entry = PLATFORM_PACKAGES[platformKey];

  if (!entry || !entry.app) {
    return null;
  }

  // The binary is at VoiceBirdCLI.app/Contents/MacOS/voice-bird-cli
  // The .app bundle is 3 levels up from the binary
  const appPath = path.resolve(binPath, "..", "..", "..");
  if (
    path.basename(appPath) === entry.app &&
    fs.existsSync(path.join(appPath, "Contents", "Info.plist"))
  ) {
    return appPath;
  }

  return null;
}

function launchViaMacOSOpen(appPath, args) {
  // Detect TTY path for stdio forwarding
  let ttyPath;
  try {
    ttyPath = execSync("tty", { stdio: ["inherit", "pipe", "pipe"] })
      .toString()
      .trim();
  } catch {
    return null; // No TTY available (e.g., piped input), fall back to direct exec
  }

  if (!ttyPath || ttyPath === "not a tty") {
    return null;
  }

  // Launch via `open` so the .app bundle is the TCC-responsible process
  // -W: wait for app to exit
  // -n: open a new instance
  // -g: don't bring to foreground
  // --stdin/--stdout/--stderr: forward stdio through TTY
  const openArgs = [
    "-W",
    "-n",
    "-g",
    "--stdin",
    ttyPath,
    "--stdout",
    ttyPath,
    "--stderr",
    ttyPath,
    appPath,
  ];

  if (args.length > 0) {
    openArgs.push("--args", ...args);
  }

  const result = spawnSync("open", openArgs, { stdio: "inherit" });

  if (result.error) {
    return null; // `open` failed, fall back to direct exec
  }

  return result;
}

const binPath = getBinaryPath();
const userArgs = process.argv.slice(2);

// On macOS: try launching via `open` for TCC compatibility (macOS 26+)
if (process.platform === "darwin" && !process.env.VOICE_BIRD_NO_OPEN) {
  const appPath = getAppBundlePath(binPath);
  if (appPath) {
    const result = launchViaMacOSOpen(appPath, userArgs);
    if (result) {
      process.exit(result.status ?? 1);
    }
    // Fall through to direct execution if `open` failed
  }
}

// Direct execution (non-macOS, or fallback)
const result = spawnSync(binPath, userArgs, { stdio: "inherit" });

if (result.error) {
  console.error(result.error.message);
  process.exit(1);
}

process.exit(result.status ?? 1);
