#!/bin/sh
set -eu

cd "$(git rev-parse --show-toplevel)"

# Source, tests, manifests and the lockfile affect this crate's checks.
if git diff --cached --quiet -- src tests Cargo.toml Cargo.lock; then
    exit 0
else
    status=$?
    if [ "$status" -ne 1 ]; then
        exit "$status"
    fi
fi

cargo fmt --check

cargo clippy --locked --all-targets -- -D warnings
cargo clippy --locked --all-targets --no-default-features -- -D warnings
