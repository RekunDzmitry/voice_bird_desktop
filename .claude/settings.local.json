{
  "permissions": {
    "allow": [
      "Bash(find:*)",
      "WebSearch",
      "WebFetch(domain:code.claude.com)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:www.brethorsting.com)",
      "Bash(export PATH=\"$HOME/bin:$HOME/.cargo/bin:/usr/bin:/bin:$PATH\")",
      "Bash(cargo clean:*)",
      "Bash(cargo build:*)",
      "Bash(xcode-select:*)",
      "Bash(export SDKROOT=/Library/Developer/CommandLineTools/SDKs/MacOSX.sdk)",
      "Bash(xcrun --show-sdk-path:*)",
      "Bash(git add:*)"
    ],
    "deny": [],
    "ask": []
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/post-commit-update-docs.sh",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
