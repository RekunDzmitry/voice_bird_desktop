{
  "permissions": {
    "allow": [
      "Bash(find:*)",
      "WebSearch",
      "WebFetch(domain:code.claude.com)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:www.brethorsting.com)",
      "Bash(xargs:*)",
      "Bash(file:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push)",
      "Bash(gh release create:*)",
      "Bash(ls:*)",
      "Bash(zip:*)",
      "Bash(ssh voicebird-root:*)"
    ],
    "deny": [],
    "ask": []
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/post-commit-update-docs.sh",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
